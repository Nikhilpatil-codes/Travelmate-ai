# ==============================================================================
# TravelMate AI — Environment Configuration (.env.example)
# Copy this file to .env and configure the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RESEND EMAIL SERVICE (SERVER-SIDE & DEVELOPMENT TESTING)
# ------------------------------------------------------------------------------
# ⚠️ SECURITY: Keep RESEND_API_KEY server-side ONLY. Never put it in frontend assets,
# mobile apps, git repositories, or compiled APKs!
#
# Get your free API key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Development Sender Address:
# Resend provides 'onboarding@resend.dev' for free development and testing.
# NO CUSTOM DOMAIN PURCHASE REQUIRED.
#
# ℹ️ Resend Testing Limitation:
# When using 'onboarding@resend.dev', Resend strictly delivers test emails to the
# email address you registered with your Resend account.
RESEND_FROM_EMAIL=TravelMate AI <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 2. SUPABASE AUTH & CUSTOM SMTP (DASHBOARD CONFIGURATION)
# ------------------------------------------------------------------------------
# Public Supabase Client Credentials (Safe for mobile APK and web client):
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Resend Custom SMTP Credentials (for Supabase Dashboard -> Auth -> SMTP Settings):
# - Enable Custom SMTP: ON
# - Sender Email: onboarding@resend.dev  (for dev testing without a custom domain)
# - Sender Name: TravelMate AI
# - Host: smtp.resend.com
# - Port: 465 (SSL) or 587 (TLS)
# - User: resend
# - Password: <Your RESEND_API_KEY>
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key_here
SMTP_SENDER_EMAIL=onboarding@resend.dev
SMTP_SENDER_NAME=TravelMate AI

# ------------------------------------------------------------------------------
# 3. BACKEND SERVICE SETTINGS (FastAPI / Uvicorn)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
PRODUCTION=false
ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI API (FOR TRAVELMATE CHATBOT)
# ------------------------------------------------------------------------------
# Store your Gemini API key here in .env (never expose on client side or in git).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

